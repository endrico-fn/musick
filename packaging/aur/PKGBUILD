# Maintainer: endrico-fn
pkgname=musick-bin
pkgver=0.2.0
pkgrel=1
pkgdesc="Modern full-Rust TUI YouTube Music streaming player (no cookies by default)"
arch=('x86_64' 'aarch64')
url="https://github.com/endrico-fn/musick"
license=('MIT')
depends=('mpv' 'yt-dlp')
optdepends=(
    'cava: live terminal audio visualizer'
    'deno: JS runtime for yt-dlp signature extraction'
)
provides=('musick')
conflicts=('musick')
source_x86_64=("${pkgname}-${pkgver}-x86_64.tar.gz::${url}/releases/download/v${pkgver}/musick-linux-x86_64.tar.gz")
source_aarch64=("${pkgname}-${pkgver}-aarch64.tar.gz::${url}/releases/download/v${pkgver}/musick-linux-aarch64.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    install -Dm755 "${srcdir}/musick" "${pkgdir}/usr/bin/musick"
}
